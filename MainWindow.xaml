<Window x:Class="Island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="620" Height="330" Title="Dynamic Island">
    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" BlurRadius="30" ShadowDepth="8" Opacity="0.42" Color="#000000"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F7F7FA"/><Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#28FFFFFF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#40FFFFFF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="#EDEDF1"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF"/><Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="Pill" Width="154" Height="25" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                Background="#F00A0B0E" BorderBrush="#36FFFFFF" BorderThickness="1" CornerRadius="16"
                Effect="{StaticResource Shadow}" ClipToBounds="True">
            <Grid>
                <Grid x:Name="CompactView" Height="25">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Ellipse Width="5" Height="5" Fill="#65DDA0"/>
                        <TextBlock Text="  " FontSize="8"/>
                        <TextBlock x:Name="CompactStatus" Text=" " Foreground="#A8A8B0" FontSize="9" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="36" Height="3" CornerRadius="2" Background="#55565D" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </Grid>
                <Grid x:Name="Panel" Width="580" Height="310" Opacity="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <!-- Windows-native title and live clock -->
                    <Grid Margin="22,17,22,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TimeText" Text="--:--" FontSize="29" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock Text="  /  " FontSize="13" Foreground="#666873" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DateText" FontSize="11" Foreground="#A7A8B0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Windows" FontSize="10" Foreground="#9FA0A8" VerticalAlignment="Center"/>
                            <Ellipse Width="6" Height="6" Fill="#65DDA0" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <!-- Media island -->
                    <Border Grid.Row="1" Style="{StaticResource MetricCard}" Margin="16,13,16,0" Padding="11">
                        <Grid Height="58">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="10" Background="#25262C" ClipToBounds="True">
                                <Grid><TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" Foreground="#7F818B" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/><Image x:Name="Art" Stretch="UniformToFill"/></Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="Nothing playing" Foreground="#F7F7F8" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ArtistText" Text="Media controls" Foreground="#A1A2AA" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Click="Prev_Click"><TextBlock Text="&#xE892;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                <Button Style="{StaticResource IconButton}" Click="Play_Click"><TextBlock x:Name="PlayIcon" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="18"/></Button>
                                <Button Style="{StaticResource IconButton}" Click="Next_Click"><TextBlock Text="&#xE893;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- System metrics -->
                    <Grid Grid.Row="2" Margin="16,11,16,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,5,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="  CPU" Foreground="#A7A8B0" FontSize="10"/></StackPanel>
                                <TextBlock x:Name="CpuText" Text="--%" Foreground="#F7F7F8" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,5"/>
                                <ProgressBar x:Name="CpuBar" Height="3" Minimum="0" Maximum="100" Value="0" Foreground="#71A7FF" Background="#30313A" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="3,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="  GPU" Foreground="#A7A8B0" FontSize="10"/></StackPanel>
                                <TextBlock x:Name="GpuText" Text="--%" Foreground="#F7F7F8" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,5"/>
                                <ProgressBar x:Name="GpuBar" Height="3" Minimum="0" Maximum="100" Value="0" Foreground="#B78AFF" Background="#30313A" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="5,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="  SOUND" Foreground="#A7A8B0" FontSize="10"/></StackPanel>
                                <TextBlock x:Name="VolumeText" Text="--%" Foreground="#F7F7F8" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="35" Height="16" Margin="-3,1,-3,0" ValueChanged="Volume_Changed"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- Quick settings -->
                    <Grid Grid.Row="3" Margin="16,11,16,15">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ActionButton}" Click="Wifi_Click" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE701;" Style="{StaticResource Icon}" FontSize="13"/><TextBlock x:Name="WifiText" Text="Wi-Fi" Foreground="#EDEDF1" FontSize="10" Margin="7,0,0,0" MaxWidth="95" TextTrimming="CharacterEllipsis"/></StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Click="Bt_Click" Margin="4,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE702;" Style="{StaticResource Icon}" FontSize="13"/><TextBlock Text="Bluetooth" Foreground="#EDEDF1" FontSize="10" Margin="7,0,0,0"/></StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ActionButton}" Click="Sound_Click" Margin="4,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="13"/><TextBlock Text="Sound" Foreground="#EDEDF1" FontSize="10" Margin="7,0,0,0"/></StackPanel>
                        </Button>
                        <Border Grid.Column="3" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="11" Padding="10,7">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE83F;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock x:Name="BatText" Text="--" Foreground="#EDEDF1" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>