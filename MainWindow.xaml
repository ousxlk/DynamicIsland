<Window x:Class="Island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="520" Height="190" Title="Island">
    <Window.Resources>
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#2AFFFFFF" CornerRadius="14" Padding="11,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Pill" Background="Black" CornerRadius="0,0,30,30"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Width="180" Height="1" Opacity="0" ClipToBounds="True">
            <Grid x:Name="Content" Width="480" Height="170" VerticalAlignment="Top" Opacity="0">
                <StackPanel Margin="22,14,22,14">
                    <Grid>
                        <TextBlock x:Name="TimeText" FontSize="30" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="DateText" FontSize="12" Foreground="#A0A0A0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </Grid>
                    <Grid Margin="0,10,0,0" Height="46">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" Background="#1AFFFFFF">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,46,46" RadiusX="9" RadiusY="9"/>
                            </Border.Clip>
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" Foreground="#888" FontSize="18" HorizontalAlignment="Center"/>
                                <Image x:Name="Art" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="No media playing" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistText" Text="Play something to see it here" FontSize="11" Foreground="#A0A0A0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Flat}" Click="Prev_Click" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE892;" FontSize="15"/>
                            </Button>
                            <Button Style="{StaticResource Flat}" Click="Play_Click" Margin="0,0,16,0">
                                <TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="20"/>
                            </Button>
                            <Button Style="{StaticResource Flat}" Click="Next_Click">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE893;" FontSize="15"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Chip}" Click="Wifi_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" FontSize="13"/>
                                <TextBlock x:Name="WifiText" Text="Wi-Fi" FontSize="11" Margin="6,0,0,0" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource Chip}" Click="Bt_Click" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE702;" FontSize="13"/>
                                <TextBlock Text="Bluetooth" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border x:Name="BatChip" Grid.Column="3" Background="#2AFFFFFF" CornerRadius="14" Padding="11,6" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BatIcon" Style="{StaticResource Icon}" Text="&#xE83F;" FontSize="13" Foreground="White"/>
                                <TextBlock x:Name="BatText" FontSize="11" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
